{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sana Assignments API",
    "version": "v0/v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Assignments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List a user's assignments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{domain}.sana.ai/api/v0/users/:userId/assignments",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List a user's assignments"
        },
        {
          "info": {
            "name": "Assign content to a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{domain}.sana.ai/api/v0/users/:userId/assignments",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Assign content to a user"
        },
        {
          "info": {
            "name": "Remove an assignment from a user",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{domain}.sana.ai/api/v0/users/:userId/assignments",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove an assignment from a user"
        }
      ]
    }
  ],
  "bundled": true
}